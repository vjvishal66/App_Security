<Window x:Class="OwaspScanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OWASP Top 10 Website Scanner" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="OWASP Top 10 (2025-ready) Web Risk Scanner" FontWeight="Bold" FontSize="20" />

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,14,0,8">
            <TextBlock Text="Target URL" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox Name="TargetUrlBox" Width="520" Text="https://example.com" />
            <Button Name="ScanButton" Margin="10,0,0,0" Width="120" Height="30" Content="Scan" Click="ScanButton_OnClick" />
            <Button Name="SaveButton" Margin="10,0,0,0" Width="120" Height="30" Content="Export JSON" Click="SaveButton_OnClick" IsEnabled="False" />
        </StackPanel>

        <TextBlock Name="StatusText" Grid.Row="2" Foreground="DarkSlateGray" Text="Idle" Margin="0,0,0,10"/>

        <DataGrid Grid.Row="3" Name="FindingsGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="150" />
                <DataGridTextColumn Header="Rule" Binding="{Binding RuleId}" Width="90" />
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" />
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="250" />
                <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="260" />
                <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="Use only on systems you own or are explicitly authorized to test." FontStyle="Italic" Margin="0,10,0,0" />
    </Grid>
</Window>
